# ============================================================================
# Hybrid H1 futures bot - environment template. Copy to `.env` and edit.
# NEVER commit the real .env (.gitignore must cover it).
# ============================================================================

# --- operating mode ---------------------------------------------------------
# BACKTEST | PAPER (default) | TESTNET | LIVE. LIVE is disabled by design and
# additionally requires LIVE_ENABLED=true AND LIVE_CONFIRMED=true below.
TRADING_MODE=PAPER

# --- persistence / logging --------------------------------------------------
DB_PATH=trading_bot.sqlite
LOG_PATH=trading_bot.log

# --- exchange connectivity (nothing here is needed for BACKTEST run via CLI) -
EXCHANGE_ID=binanceusdm
# API keys are REQUIRED for TESTNET and LIVE. Use Binance FUTURES TESTNET keys
# for TESTNET mode (https://testnet.binancefuture.com). Keys grant trading
# rights - treat the file they live in as a secret.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- universe (ENGINEERING DEFAULTS - tune and record per experiment) --------
MAX_SYMBOLS=10
MIN_QUOTE_VOLUME=20000000
MAX_SPREAD=0.002
HISTORY_BARS=400
POLL_INTERVAL=60
QUOTE_MAX_AGE=30

# --- strategy (spec-mandated research defaults; see README before changing) --
RANGE_LOOKBACK=120
MIN_RANGE_DURATION=20
MIN_SUPPORT_TESTS=2
MIN_RESISTANCE_TESTS=2
LEVEL_TOLERANCE=0.004
MIN_TEST_SEPARATION=3
PIVOT_LEFT=3
PIVOT_RIGHT=3
MAX_STRUCTURE_EVENT_WINDOW=5
MA_RETEST_TOLERANCE=0.0015
ENTRY_WINDOW=12
ENTRY_COOLDOWN=3
BREAKOUT_BUFFER=0.001
BOS_BUFFER=0.0005

# --- candlestick confirmation (spec thresholds) ------------------------------
# tolerances/geometry are in config.py; these are the tuned ones:
STOP_METHOD=conservative_combined
STOP_BUFFER=0.001

# --- risk (spec caps; DO NOT raise beyond the values below without review) ---
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=3
MAX_TOTAL_RISK=0.03
DAILY_LOSS_LIMIT=0.03
MAX_LEVERAGE=2.0
MAX_ENTRY_SLIPPAGE=0.002
MIN_NET_RR=1.8
INITIAL_EQUITY=10000
DAILY_EQUITY_REFERENCE=10000

# --- simulated costs (paper/backtest realism) --------------------------------
TAKER_FEE=0.0005
SIMULATED_SLIPPAGE=0.0005

# --- execution resilience ----------------------------------------------------
ORDER_TIMEOUT=10
MAX_RETRIES=3
REQUEST_TIMEOUT=15
MAX_CONCURRENCY=5

# --- notifications (optional) ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LIVE SAFETY GATE --------------------------------------------------------
# Both flags must be "true" for LIVE mode to pass validation. Keep them unset
# unless a human operator has explicitly decided to trade real funds.
LIVE_ENABLED=
LIVE_CONFIRMED=

# --- backtest -----------------------------------------------------------------
BACKTEST_DAYS=180
WALK_FORWARD_TRAIN_DAYS=60
WALK_FORWARD_TEST_DAYS=20

# --- self-learning / optimization (OFF by default; see README) ----------------
# OPT_AUTO=true runs bounded optimization cycles from the paper loop
# (interval + trade-count + memory gated). All knobs are safe defaults;
# train+valid+oos+shadow days must fit in OPT_MAX_WINDOW_DAYS.
OPT_AUTO=false
OPT_INTERVAL_HOURS=24
OPT_MIN_NEW_TRADES=5
OPT_MIN_TOTAL_TRADES=20
OPT_MAX_WINDOW_DAYS=180
OPT_MAX_COMBOS=20
OPT_MAX_RUNTIME_MINUTES=20
OPT_MAX_SYMBOLS=5
OPT_MIN_FREE_MB=100
OPT_TRAIN_DAYS=60
OPT_VALID_DAYS=30
OPT_OOS_DAYS=30
OPT_SHADOW_DAYS=20
OPT_TOP_K=3
OPT_MIN_OOS_TRADES=8
OPT_IMPROVEMENT_MARGIN_PCT=0.05
OPT_MAX_DRAWDOWN_PCT=15
OPT_OOS_REUSE_LIMIT=3
# optional per-run grid overrides (comma lists; bounds clamped to code limits):
# OPT_PARAMS=ma_retest_tolerance,entry_window
# OPT_GRID_entry_window=6,9,12,15
# OPT_BOUND_entry_window=6,18

# --- learning statistics / rollback (evidence-based; never one losing trade) --
STATS_MIN_SAMPLE=10
ROLLBACK_MIN_TRADES=20
ROLLBACK_EXPECTANCY_FLOOR=-0.1
ROLLBACK_GRACE_RUNS=2
ROLLBACK_EVAL_INTERVAL_HOURS=24
ROLLBACK_ERROR_WINDOW_HOURS=6
ROLLBACK_ERROR_THRESHOLD=5
